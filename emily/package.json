{
  "name": "coverletter-emily",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Emily — aprendizajes: generador de cartas de interés split-brain (transformers.js local + Gemini vía Firebase AI Logic)",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "eval": "tsx eval/run.ts",
    "eval:report": "tsx eval/report.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@huggingface/transformers": "4.3.0",
    "firebase": "12.19.0",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@google/genai": "2.24.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.2"
  }
}
