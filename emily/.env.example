# Firebase web config for the "coverletter-emily" web app.
# Get the values with:  firebase apps:sdkconfig WEB <appId> --project <projectId>
# Copy this file to .env.local and fill it in. .env.local is gitignored.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# App Check (required by this project for the online letter). Use ONE of these:
# reCAPTCHA Enterprise site key of the "coverletter-emily" key (allows localhost too): gcloud recaptcha keys list --project viaticos-spending-mngmt
VITE_RECAPTCHA_ENTERPRISE_KEY=
# Dev-only App Check debug token (Firebase console > App Check > Apps > Manage debug tokens); ignored by production builds.
VITE_APPCHECK_DEBUG_TOKEN=
