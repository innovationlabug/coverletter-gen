# Firebase web config for the "coverletter-emily" web app.
# Get the values with:  firebase apps:sdkconfig WEB <appId> --project <projectId>
# Copy this file to .env.local and fill it in. .env.local is gitignored.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Optional: reCAPTCHA Enterprise site key. If set, Firebase App Check is initialized.
VITE_RECAPTCHA_ENTERPRISE_KEY=
