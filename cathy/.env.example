# Copia a .env.local (gitignored) y llena los valores. NUNCA subas tokens ni llaves.

# Ollama (tier 1, nube privada). Local: http://localhost:11434 · Cloud Run: https://ollama-coverletter-...run.app
OLLAMA_URL=
# Modelo privado que usa la app (la UI no lo expone): gemma4:e2b-it-qat | qwen3.5:2b
OLLAMA_MODEL=
# Opcional, solo desarrollo local contra Cloud Run: salida de `gcloud auth print-identity-token` (expira en 1 h)
OLLAMA_TOKEN=

# Gemini vía Vertex AI (tier 2). Sin API key: usa ADC / la cuenta de servicio de Cloud Run.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_GENAI_USE_VERTEXAI=
GEMINI_MODEL=
